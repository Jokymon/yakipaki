    "check": "npm run typecheck && npm run doctor"
  },
  "dependencies": {
    "expo": "~58.0.0",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "expo-doctor": "^1.18.0",
    "typescript": "~6.0.3"
  }
}
